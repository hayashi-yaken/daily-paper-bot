
# --- General Settings ---

# User-Agent to identify the client when making API requests.
# It's recommended to set a custom user agent.
CUSTOM_USER_AGENT="daily-paper-bot/1.0 (+https://github.com/your/repo)"

# Set to "true" to run the bot without posting messages or saving data.
# Useful for testing and debugging.
DRY_RUN="false"


# --- Notifier Settings ---

# (Required) The target platform to post messages.
# Options: "slack" or "discord"
TARGET_PLATFORM="slack"

# (Optional) The maximum number of characters for the abstract.
# Default: 1200
ABSTRACT_MAX_CHARS="1200"


# --- Slack Settings (if TARGET_PLATFORM is "slack") ---

# (Required) Slack Bot Token (should be kept secret).
# Example: "xoxb-..."
SLACK_BOT_TOKEN=""

# (Required) Slack Channel ID to post messages.
# Example: "C12345678"
SLACK_CHANNEL_ID=""


# --- Discord Settings (if TARGET_PLATFORM is "discord") ---

# (Required) Discord Webhook URL (should be kept secret).
# Example: "https://discord.com/api/webhooks/..."
DISCORD_WEBHOOK_URL=""


# --- Selector Settings ---

# (Optional) The strategy to select a paper.
# Default: "random"
SELECT_STRATEGY="random"
# --- Azure AI Translator (任意, abstract の日本語訳) ---
# TRANSLATE_ENABLED="false"
# AZURE_TRANSLATOR_KEY=""
# AZURE_TRANSLATOR_REGION="japaneast"
# 通常はデフォルトのままで OK
# AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"


# --- OpenReview Authentication (optional, but recommended) ---
# Unauthenticated API access may be blocked (403 ChallengeRequiredError)
# depending on the network. Set your OpenReview account credentials.

# (Optional) OpenReview account email.
# NOTE: Authentication (Login) is performed only when BOTH OR_EMAIL and
# OR_PASSWORD are set. If either one is missing, the bot silently falls back
# to anonymous access, which may be blocked (403 ChallengeRequiredError).
# Set them together as a pair.
OR_EMAIL=""

# (Optional) OpenReview account password (should be kept secret).
OR_PASSWORD=""
